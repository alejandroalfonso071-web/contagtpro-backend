# ─── ContaGT Pro Backend — Variables de Entorno ───────────────────────────────
# Copia este archivo como .env y configura tus valores reales
# Railway lee estas variables automáticamente desde el panel de configuración

# Puerto (Railway lo asigna automáticamente — no modificar en producción)
PORT=3000

# Ambiente: development | production
NODE_ENV=production

# API Key de seguridad — genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se configura, el backend queda abierto (solo para desarrollo local)
API_KEY=tu-api-key-secreta-aqui-genera-una-con-crypto

# Orígenes CORS permitidos (separados por coma)
# En producción: pon la URL exacta de tu frontend en Vercel o Railway
# Para desarrollo: usa * para permitir cualquier origen
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-frontend.railway.app

# ─── Configuración opcional SAT ───────────────────────────────────────────────
# Timeout en ms para consultas al portal SAT (default: 12000)
SAT_TIMEOUT_MS=12000

# Máximo de reintentos si SAT no responde (default: 2)
SAT_MAX_RETRIES=2
